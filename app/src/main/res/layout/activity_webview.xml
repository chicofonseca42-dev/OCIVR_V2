<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- BARRA DE TOPO / TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Botão Voltar -->
        <ImageButton
            android:id="@+id/btnVoltarWeb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <!-- Título e Subtítulo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/txtTituloWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Navegador"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Botão Recarregar -->
        <ImageButton
            android:id="@+id/btnRecarregarWeb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Recarregar"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#4DD0E1" />

        <!-- Botão Fechar -->
        <ImageButton
            android:id="@+id/btnFecharWeb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- BARRA DE PROGRESSO DE CARREGAMENTO -->
    <ProgressBar
        android:id="@+id/progressoWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="#4DD0E1"
        android:progressBackgroundTint="#1E293B"
        android:visibility="gone" />

    <!-- CONTAINER WEBVIEW -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A" />

</LinearLayout>
